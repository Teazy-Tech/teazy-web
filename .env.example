# Copy to .env.local and fill in. Never commit real values.
# Values for staging come from the team password manager (OPS-02).

# Public (sent to the browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://<staging-project>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only
# OPENAPI_SCHEMA=../teazy-api/openapi/openapi.json   # override for pnpm codegen
# E2E_BASE_URL=                                       # Playwright against a deployed preview
